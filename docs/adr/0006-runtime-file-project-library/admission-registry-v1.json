{
  "format": "lumina-project-admission-registry",
  "version": 1,
  "canonicalization": "RFC8785-JCS-SHA256-v1",
  "unknownFieldPolicy": {
    "objects": "reject",
    "nodeTypes": "reject",
    "sourceMetadataKeys": "allow-grammar-bound-scalars-only",
    "providerParameterKeys": "reject",
    "error": "project_secret_admission_failed"
  },
  "validationOrder": [
    "bounded-utf8-and-duplicate-member-parse",
    "exact-field-registry-validation",
    "secret-and-url-admission",
    "normalization-and-authorized-omission",
    "canonical-hash-or-byte-staging"
  ],
  "limits": {
    "maxProjectRecordsPerImport": 64,
    "maxAssetsPerImport": 256,
    "maxAggregateAssetBytesPerImport": 6442450944,
    "maxDurableLibraryAssetBytes": 2147483648,
    "maxRuntimeStreamedArchiveEnvelopeBytes": 8589934592,
    "maxBrowserBufferedArchiveEnvelopeBytes": 536870912,
    "maxBrowserMigrationTransferAggregateBytes": 8589934592,
    "maxAssetMetadataDocumentBytes": 65536,
    "maxSourceMetadataEntries": 32,
    "maxSourceMetadataStringBytes": 32768,
    "maxArchiveManifestBytes": 4194304,
    "maxProjectDocumentBytes": 4194304,
    "maxHistoryDocumentBytes": 16777216,
    "maxPersistedHistorySnapshotsPerDirection": 12,
    "maxTransferJsonPayloadBytes": 1048576,
    "maxTransferChunkPayloadBytes": 4194304,
    "maxTransferHeaderBytes": 65536,
    "maxTransferFrameBytes": 4259840,
    "maxGatewayTemporaryMediaBytes": 67108864
  },
  "limitSemantics": {
    "maxDurableLibraryAssetBytes": {
      "scope": "target-runtime-file-library-direct-asset-write",
      "transport": "streamed",
      "currentBrowserIndexedDb": "quota-gated-no-static-per-asset-cap"
    },
    "maxAggregateAssetBytesPerImport": {
      "scope": "one-target-library-import-admitted-assets",
      "transport": "streamed",
      "includes": "sum-of-admitted-asset-byte-counts"
    },
    "maxRuntimeStreamedArchiveEnvelopeBytes": {
      "scope": "one-target-runtime-lumina-archive",
      "transport": "streamed-archive-container-bytes"
    },
    "maxBrowserBufferedArchiveEnvelopeBytes": {
      "scope": "browser-archive-verifier-before-array-buffer",
      "transport": "single-buffer",
      "currentBrowserVerifier": "no-static-cap-before-array-buffer"
    },
    "maxBrowserMigrationTransferAggregateBytes": {
      "scope": "one-browser-migration-candidate",
      "transport": "sum-of-frame-payload-bytes"
    },
    "maxGatewayTemporaryMediaBytes": {
      "scope": "current-generation-gateway-publish-and-transcode-only",
      "transport": "temporary-copy",
      "isDurableLibraryLimit": false
    }
  },
  "archiveContainerSemantics": {
    "legacyBrowserVerifier": {
      "acceptedContainer": "zip32",
      "reader": "whole-blob-array-buffer",
      "maxEnvelopeLimit": "maxBrowserBufferedArchiveEnvelopeBytes"
    },
    "targetRuntime": {
      "acceptedContainers": ["zip32", "zip64"],
      "reader": "stream-every-entry",
      "maxEnvelopeLimit": "maxRuntimeStreamedArchiveEnvelopeBytes",
      "zip64RequiredAboveBytes": 4294967295
    }
  },
  "limitErrorCodes": {
    "durableAsset": "asset_too_large",
    "aggregateImport": "import_asset_aggregate_too_large",
    "runtimeArchiveEnvelope": "archive_envelope_too_large",
    "browserBufferedArchiveEnvelope": "browser_buffered_archive_too_large",
    "migrationTransferAggregate": "migration_transfer_too_large",
    "transferFrame": "migration_transfer_frame_too_large",
    "mediaType": "unsupported_media_type"
  },
  "media": {
    "mimeGrammar": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
    "parameters": "reject",
    "normalization": "ascii-lowercase-exact",
    "fallback": {
      "empty": "reject-unsupported_media_type",
      "application/octet-stream": "reject-unsupported_media_type",
      "kindMismatch": "reject-unsupported_media_type",
      "notAllowlisted": "reject-unsupported_media_type",
      "gatewayTranscode": "not-a-durable-library-admission-fallback"
    },
    "allowlist": {
      "image": [
        "image/avif",
        "image/bmp",
        "image/gif",
        "image/jpeg",
        "image/png",
        "image/svg+xml",
        "image/webp"
      ],
      "audio": [
        "audio/aac",
        "audio/flac",
        "audio/mpeg",
        "audio/mp4",
        "audio/ogg",
        "audio/wav",
        "audio/webm",
        "audio/x-wav"
      ],
      "video": [
        "video/avi",
        "video/mp4",
        "video/mpeg",
        "video/quicktime",
        "video/webm",
        "video/x-matroska"
      ]
    }
  },
  "fieldProfiles": {
    "requiredId": {
      "type": "string",
      "required": true,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject",
      "maxUtf8Bytes": 256
    },
    "optionalId": {
      "type": "string|null",
      "required": false,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject",
      "maxUtf8Bytes": 256
    },
    "requiredSafeInteger": {
      "type": "safe-integer",
      "required": true,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "optionalSafeInteger": {
      "type": "safe-integer|null",
      "required": false,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "requiredFiniteNumber": {
      "type": "finite-number",
      "required": true,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "optionalFiniteNumber": {
      "type": "finite-number|null",
      "required": false,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "requiredBoolean": {
      "type": "boolean",
      "required": true,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "optionalBoolean": {
      "type": "boolean|null",
      "required": false,
      "classification": "structural",
      "normalization": "none",
      "credentialAction": "reject"
    },
    "requiredUserText": {
      "type": "string",
      "required": true,
      "classification": "user-text",
      "normalization": "none",
      "credentialAction": "reject",
      "maxUtf8Bytes": 262144
    },
    "optionalUserText": {
      "type": "string|null",
      "required": false,
      "classification": "user-text",
      "normalization": "none",
      "credentialAction": "reject",
      "maxUtf8Bytes": 262144
    },
    "optionalSensitiveText": {
      "type": "string|null",
      "required": false,
      "classification": "optional-sensitive",
      "normalization": "none",
      "credentialAction": "omit-member",
      "maxUtf8Bytes": 262144
    },
    "requiredHttpUrlOrNull": {
      "type": "string|null",
      "required": true,
      "classification": "url",
      "normalization": "none",
      "credentialAction": "reject",
      "allowedSchemes": ["http:", "https:"],
      "forbid": ["username", "password", "query", "fragment"],
      "maxUtf8Bytes": 2048
    },
    "optionalHttpUrlOrNull": {
      "type": "string|null",
      "required": false,
      "classification": "url",
      "normalization": "none",
      "credentialAction": "reject",
      "allowedSchemes": ["http:", "https:"],
      "forbid": ["username", "password", "query", "fragment"],
      "maxUtf8Bytes": 2048
    },
    "optionalDerivedDisplayUrl": {
      "type": "string|null",
      "required": false,
      "classification": "derived-display-url",
      "normalization": "omit-when-asset-backed-or-in-history",
      "credentialAction": "reject",
      "allowedSchemes": ["http:", "https:"],
      "forbid": ["username", "password", "query", "fragment"],
      "maxUtf8Bytes": 2048
    },
    "optionalSensitiveHttpUrl": {
      "type": "string|null",
      "required": false,
      "classification": "optional-sensitive",
      "normalization": "none",
      "credentialAction": "omit-member",
      "allowedSchemes": ["http:", "https:"],
      "forbid": ["username", "password", "query", "fragment"],
      "maxUtf8Bytes": 2048
    },
    "runtimeOnlyBoolean": {
      "type": "boolean|null",
      "required": false,
      "classification": "optional-sensitive",
      "normalization": "drop",
      "credentialAction": "omit-member"
    },
    "runtimeOnlyObject": {
      "type": "object|null",
      "required": false,
      "classification": "optional-sensitive",
      "normalization": "drop",
      "credentialAction": "omit-member"
    },
    "assetReference": {
      "type": "string|null",
      "required": false,
      "classification": "asset-reference",
      "normalization": "none",
      "credentialAction": "reject",
      "maxUtf8Bytes": 256
    },
    "assetReferenceArray": {
      "type": "array<string>",
      "required": false,
      "classification": "asset-reference",
      "normalization": "preserve-order",
      "credentialAction": "reject",
      "maxItems": 256,
      "maxItemUtf8Bytes": 256
    },
    "providerParams": {
      "type": "object",
      "required": false,
      "classification": "container",
      "normalization": "preserve-known-members",
      "credentialAction": "reject"
    },
    "generationHandle": {
      "type": "object|null",
      "required": false,
      "classification": "container",
      "normalization": "validate-browser-direct-v1",
      "credentialAction": "reject"
    }
  },
  "sourceRecords": {
    "storedProjectRecord": {
      "fields": {
        "id": { "profile": "requiredId" },
        "name": { "profile": "requiredUserText", "maxUtf8Bytes": 1024 },
        "createdAt": { "profile": "requiredSafeInteger" },
        "updatedAt": { "profile": "requiredSafeInteger" },
        "nodeCount": { "profile": "requiredSafeInteger", "minimum": 0 },
        "revision": { "profile": "optionalId" },
        "schemaVersion": { "profile": "optionalSafeInteger" },
        "nodesJson": { "type": "json-string", "required": true, "classification": "container", "normalization": "parse-nodes-layout", "credentialAction": "reject" },
        "edgesJson": { "type": "json-string", "required": true, "classification": "container", "normalization": "parse-canvas-edge-array", "credentialAction": "reject" },
        "viewportJson": { "type": "json-string", "required": true, "classification": "container", "normalization": "parse-viewport", "credentialAction": "reject" },
        "recovery": { "type": "ProjectRecovery|null", "required": false, "classification": "structural", "normalization": "must-match-meta-observation", "credentialAction": "reject" }
      }
    },
    "storedHistoryRecord": {
      "fields": {
        "projectId": { "profile": "requiredId" },
        "historyJson": { "type": "json-string", "required": true, "classification": "container", "normalization": "parse-history", "credentialAction": "reject" }
      }
    },
    "projectRecordReadModel": {
      "fields": {
        "historyJson": { "type": "json-string", "required": true, "classification": "container", "normalization": "parse-history", "credentialAction": "reject" },
        "recovery": { "type": "ProjectRecovery|null", "required": false, "classification": "structural", "normalization": "must-match-meta-observation", "credentialAction": "reject" }
      }
    }
  },
  "schemas": {
    "ProjectRecovery": {
      "fields": {
        "reason": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["unsupported_schema", "migration_failed"] }
      }
    },
    "nodesJson": {
      "acceptedLayouts": [
        { "layout": "legacy-array", "type": "array<CanvasNode>" },
        { "layout": "v1-object", "type": "object", "fields": { "nodes": "array<CanvasNode>", "imagePool": "array<HttpUrl>" } }
      ],
      "unknownFieldPolicy": "reject",
      "imagePool": { "maxItems": 4096, "itemProfile": "requiredHttpUrlOrNull", "nullItems": "reject" }
    },
    "projectDocument": {
      "fields": {
        "schemaVersion": { "type": "safe-integer", "required": true, "classification": "structural", "normalization": "missing-or-zero-to-1", "credentialAction": "reject", "enum": [1] },
        "id": { "profile": "requiredId" },
        "name": { "profile": "requiredUserText", "maxUtf8Bytes": 1024 },
        "createdAt": { "profile": "requiredSafeInteger" },
        "updatedAt": { "profile": "requiredSafeInteger" },
        "nodeCount": { "profile": "requiredSafeInteger", "minimum": 0 },
        "revision": { "profile": "requiredId", "normalization": "missing-to-r0" },
        "nodes": { "type": "array<CanvasNode>", "required": true, "classification": "container", "normalization": "preserve-order", "credentialAction": "reject", "maxItems": 5000 },
        "edges": { "type": "array<CanvasEdge>", "required": true, "classification": "container", "normalization": "preserve-order", "credentialAction": "reject", "maxItems": 20000 },
        "viewport": { "type": "Viewport", "required": true, "classification": "container", "normalization": "finite-values", "credentialAction": "reject" }
      }
    },
    "history": {
      "fields": {
        "past": { "type": "array<CanvasHistorySnapshot>", "required": true, "classification": "container", "normalization": "keep-last-12", "credentialAction": "reject", "maxItems": 12 },
        "future": { "type": "array<CanvasHistorySnapshot>", "required": true, "classification": "container", "normalization": "keep-last-12", "credentialAction": "reject", "maxItems": 12 }
      }
    },
    "CanvasHistorySnapshot": {
      "fields": {
        "nodes": { "type": "array<CanvasNode>", "required": true, "classification": "container", "normalization": "history-display-url-strip", "credentialAction": "reject", "maxItems": 5000 },
        "edges": { "type": "array<CanvasEdge>", "required": true, "classification": "container", "normalization": "preserve-order", "credentialAction": "reject", "maxItems": 20000 }
      }
    },
    "Viewport": {
      "fields": {
        "x": { "profile": "requiredFiniteNumber" },
        "y": { "profile": "requiredFiniteNumber" },
        "zoom": { "profile": "requiredFiniteNumber", "minimumExclusive": 0 }
      }
    },
    "CanvasNode": {
      "fields": {
        "id": { "profile": "requiredId" },
        "type": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["uploadNode", "imageNode", "exportImageNode", "textGenerationNode", "textAnnotationNode", "groupNode", "storyboardNode", "storyboardGenNode", "videoFrameNode", "videoSingleNode", "seedanceAutoVideoNode", "exportVideoNode", "audioUploadNode", "videoUploadNode", "audioUploadRefNode", "videoUploadRefNode", "sd2VideoGenNode"] },
        "position": { "type": "Position", "required": true, "classification": "container", "normalization": "finite-values", "credentialAction": "reject" },
        "data": { "type": "node-type-discriminated-object", "required": true, "classification": "container", "normalization": "variant-schema", "credentialAction": "reject" },
        "width": { "profile": "optionalFiniteNumber", "minimumExclusive": 0 },
        "height": { "profile": "optionalFiniteNumber", "minimumExclusive": 0 },
        "parentId": { "profile": "optionalId" },
        "extent": { "type": "enum|null", "required": false, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["parent"] },
        "zIndex": { "profile": "optionalSafeInteger" },
        "selected": { "profile": "runtimeOnlyBoolean" },
        "dragging": { "profile": "runtimeOnlyBoolean" }
      }
    },
    "Position": {
      "fields": {
        "x": { "profile": "requiredFiniteNumber" },
        "y": { "profile": "requiredFiniteNumber" }
      }
    },
    "CanvasEdge": {
      "fields": {
        "id": { "profile": "requiredId" },
        "source": { "profile": "requiredId" },
        "target": { "profile": "requiredId" },
        "sourceHandle": { "profile": "optionalId" },
        "targetHandle": { "profile": "optionalId" },
        "type": { "type": "enum|null", "required": false, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["default", "straight", "step", "smoothstep", "disconnectable"] },
        "data": { "type": "CanvasEdgeData", "required": false, "classification": "container", "normalization": "known-members", "credentialAction": "reject" },
        "selected": { "profile": "runtimeOnlyBoolean" }
      }
    },
    "CanvasEdgeData": {
      "fields": {
        "valueType": { "type": "enum|null", "required": false, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["text", "image", "audio", "video"] },
        "inputOrder": { "profile": "optionalSafeInteger", "minimum": 0 }
      }
    },
    "AssetMetadata": {
      "fields": {
        "assetId": { "profile": "requiredId" },
        "projectId": { "profile": "requiredId" },
        "kind": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["image", "video", "audio"] },
        "mimeType": { "type": "allowlisted-media-mime", "required": true, "classification": "structural", "normalization": "ascii-lowercase-exact", "credentialAction": "reject" },
        "byteCount": { "profile": "requiredSafeInteger", "minimum": 0, "maximum": 2147483648 },
        "createdAt": { "profile": "requiredSafeInteger" },
        "sourceKind": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["import", "generation", "derived"] },
        "width": { "profile": "optionalSafeInteger", "minimum": 0 },
        "height": { "profile": "optionalSafeInteger", "minimum": 0 },
        "durationMs": { "profile": "optionalSafeInteger", "minimum": 0 },
        "sourceMetadata": { "type": "AssetSourceMetadata", "required": true, "classification": "container", "normalization": "grammar-bound-scalar-map", "credentialAction": "reject" },
        "lifecycleState": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["active", "deletion-candidate", "staging"] }
      }
    },
    "AssetSourceMetadata": {
      "type": "bounded-scalar-map",
      "maxEntries": "limits.maxSourceMetadataEntries",
      "maxCanonicalUtf8Bytes": "limits.maxAssetMetadataDocumentBytes",
      "key": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
        "normalization": "preserve-exact",
        "sensitiveNameNormalization": "ascii-alnum-lowercase",
        "sensitiveNameAction": "reject"
      },
      "value": {
        "types": ["string", "finite-number", "boolean", "null"],
        "string": {
          "maxUtf8Bytes": "limits.maxSourceMetadataStringBytes",
          "normalization": "preserve-exact-after-secret-url-scan",
          "credentialAction": "reject"
        },
        "finite-number": {
          "normalization": "rfc8785-jcs-number--negative-zero-to-zero"
        },
        "boolean": { "normalization": "preserve-exact" },
        "null": { "normalization": "preserve-exact" }
      },
      "nestedArrayOrObject": "reject",
      "unknownKeyOrValue": "reject"
    },
    "StoryboardFrameItem": {
      "fields": {
        "id": { "profile": "requiredId" },
        "assetId": { "profile": "assetReference" },
        "previewAssetId": { "profile": "assetReference" },
        "imageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "previewImageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "aspectRatio": { "profile": "optionalUserText", "maxUtf8Bytes": 32 },
        "note": { "profile": "requiredUserText", "maxUtf8Bytes": 8192 },
        "order": { "profile": "requiredSafeInteger", "minimum": 0 }
      }
    },
    "StoryboardGenFrameItem": {
      "fields": {
        "id": { "profile": "requiredId" },
        "description": { "profile": "requiredUserText", "maxUtf8Bytes": 8192 },
        "referenceIndex": { "profile": "optionalSafeInteger", "minimum": 0 }
      }
    },
    "StoryboardExportOptions": {
      "fields": {
        "showFrameIndex": { "profile": "requiredBoolean" },
        "showFrameNote": { "profile": "requiredBoolean" },
        "notePlacement": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["overlay", "bottom"] },
        "imageFit": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["cover", "contain"] },
        "frameIndexPrefix": { "profile": "requiredUserText", "maxUtf8Bytes": 32 },
        "cellGap": { "profile": "requiredFiniteNumber", "minimum": 0, "maximum": 4096 },
        "outerPadding": { "profile": "requiredFiniteNumber", "minimum": 0, "maximum": 4096 },
        "fontSize": { "profile": "requiredFiniteNumber", "minimum": 1, "maximum": 20 },
        "backgroundColor": { "profile": "requiredUserText", "maxUtf8Bytes": 64 },
        "textColor": { "profile": "requiredUserText", "maxUtf8Bytes": 64 }
      }
    },
    "BrowserGenerationJobHandle": {
      "fields": {
        "version": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": [1] },
        "kind": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["browser-direct"] },
        "externalTaskId": { "profile": "requiredId" },
        "protocol": { "profile": "requiredUserText", "maxUtf8Bytes": 128 },
        "baseUrl": { "profile": "requiredHttpUrlOrNull" },
        "model": { "profile": "requiredUserText", "maxUtf8Bytes": 512 },
        "statusUrl": { "profile": "optionalSensitiveHttpUrl" },
        "resultUrl": { "profile": "optionalSensitiveHttpUrl" },
        "temporaryMediaKeys": { "type": "array<string>", "required": false, "classification": "structural", "normalization": "deduplicate-preserve-order", "credentialAction": "reject", "maxItems": 16, "itemPattern": "^[A-Za-z0-9_-]{1,256}$" }
      }
    },
    "ProviderParams": {
      "fields": {
        "thinking_level": { "type": "enum", "required": false, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["off", "minimal", "high"] },
        "enable_search": { "profile": "optionalBoolean" },
        "enable_web_search": { "profile": "optionalBoolean" },
        "grsai_pro_model": { "profile": "optionalUserText", "maxUtf8Bytes": 512 }
      }
    }
  },
  "nodeData": {
    "uploadNode": {
      "fields": {
        "displayName": { "profile": "optionalUserText", "maxUtf8Bytes": 1024 },
        "assetId": { "profile": "assetReference" },
        "previewAssetId": { "profile": "assetReference" },
        "imageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "previewImageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "aspectRatio": { "profile": "requiredUserText", "maxUtf8Bytes": 32 },
        "isSizeManuallyAdjusted": { "profile": "optionalBoolean" },
        "sourceFileName": { "profile": "optionalUserText", "maxUtf8Bytes": 1024 }
      }
    },
    "imageNode": {
      "fields": {
        "displayName": { "profile": "optionalUserText", "maxUtf8Bytes": 1024 },
        "assetId": { "profile": "assetReference" },
        "previewAssetId": { "profile": "assetReference" },
        "imageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "previewImageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "aspectRatio": { "profile": "requiredUserText", "maxUtf8Bytes": 32 },
        "isSizeManuallyAdjusted": { "profile": "optionalBoolean" },
        "prompt": { "profile": "requiredUserText" },
        "model": { "profile": "requiredUserText", "maxUtf8Bytes": 512 },
        "size": { "type": "enum", "required": true, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": ["0.5K", "1K", "2K", "4K"] },
        "outputCount": { "type": "enum", "required": false, "classification": "structural", "normalization": "none", "credentialAction": "reject", "enum": [1, 2, 4] },
        "requestAspectRatio": { "profile": "optionalUserText", "maxUtf8Bytes": 32 },
        "extraParams": { "profile": "providerParams", "schema": "ProviderParams" },
        "isGenerating": { "profile": "runtimeOnlyBoolean" },
        "generationStartedAt": { "profile": "optionalSafeInteger", "normalization": "drop" },
        "generationDurationMs": { "profile": "optionalSafeInteger", "minimum": 0 }
      }
    },
    "exportImageNode": {
      "fields": {
        "displayName": { "profile": "optionalUserText", "maxUtf8Bytes": 1024 },
        "assetId": { "profile": "assetReference" },
        "previewAssetId": { "profile": "assetReference" },
        "imageUrl": { "profile": "optionalDerivedDisplayUrl" },
        "previewImageUrl": { "profile": "optionalDerivedDisplayUrl" },
