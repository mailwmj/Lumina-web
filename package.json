{
  "name": "lumina",
  "private": true,
  "version": "0.2.32",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run package:canvas-web",
    "test:web-only": "node --test scripts/web-only-contract.node-test.mjs",
    "test:local-runtime": "npm run canvas-agent:build && node --test --test-concurrency=1 runtime/builtBridgeProtocol.node-test.mjs runtime/gatewayProcess.node-test.mjs runtime/installationMetadata.node-test.mjs runtime/localRuntime.node-test.mjs runtime/installationStartupLock.node-test.mjs runtime/loopbackOrigin.node-test.mjs runtime/productionRuntime.node-test.mjs runtime/installedRuntimeEntrypoint.node-test.mjs runtime/installedCanvasMcp.node-test.mjs",
    "test:installer": "node --test --test-concurrency=1 runtime/installedRuntime.node-test.mjs installer/packageInstaller.node-test.mjs scripts/package-local-runtime.node-test.mjs scripts/package-installer.node-test.mjs",
    "test:local-release-gate": "node --test scripts/local-release-acceptance-gate.node-test.mjs",
    "verify:local-release": "node scripts/local-release-acceptance-gate.mjs --verify",
    "test:release-gate": "node --test scripts/web-release-gate.node-test.mjs",
    "verify:web-release": "node scripts/web-release-gate.mjs --verify",
    "pretest:e2e": "npm run canvas-agent:build",
    "test:e2e": "playwright test",
    "pretest:production-runtime": "npm run build && npm run canvas-agent:build",
    "test:production-runtime": "playwright test --config playwright.production-runtime.config.ts",
    "preview": "vite preview",
    "gateway:dev": "node gateway/server.mjs",
    "canvas-agent:build": "npm run build --prefix canvas-agent",
    "canvas-agent:dev": "npm run dev --prefix canvas-agent",
    "canvas-agent:start": "npm run start --prefix canvas-agent",
    "canvas-agent:test": "npm test --prefix canvas-agent",
    "package:canvas-web": "node scripts/package-canvas-web.mjs",
    "package:runtime": "node scripts/package-local-runtime.mjs",
    "package:installer:plan": "node scripts/package-installer.mjs --plan",
    "package:installer:prepare": "npm run build && npm run canvas-agent:build && node scripts/package-installer.mjs --prepare",
    "package:installer": "npm run build && npm run canvas-agent:build && node scripts/package-installer.mjs --release",
    "canvas:codex": "npm run build && npm run canvas-agent:build && node canvas-agent/dist/index.js web-mcp --web-root dist",
    "canvas:runtime": "npm run build && npm run canvas-agent:build && node runtime/startProductionRuntime.mjs",
    "canvas:codex:dev": "npm run canvas-agent:build && node scripts/start-codex-canvas.mjs",
    "canvas:codex:dev:test": "npm run canvas-agent:build && node --test scripts/start-codex-canvas.node-test.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.75.0",
    "@xyflow/react": "^12.5.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "konva": "^9.3.22",
    "lucide-react": "1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-i18next": "^15.4.1",
    "react-image-crop": "^11.0.10",
    "react-konva": "^18.2.10",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.3",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.1.0",
    "vitest": "^4.1.9"
  }
}
